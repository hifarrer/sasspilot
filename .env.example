# ─── Database ──────────────────────────────────────────────────────────────
# Local dev: SQLite needs no install. Prod: swap for a Postgres URL (Neon/Supabase)
# and change the provider in apps/web/prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# ─── Auth.js (NextAuth v5) ─────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# OAuth providers (configure at least one)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Anthropic (AI description generation) ─────────────────────────────────
ANTHROPIC_API_KEY=""
# Default model for description generation (opus selectable per-request)
AI_MODEL="claude-sonnet-4-6"

# ─── Public base URL of the web app (used by the extension) ────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
